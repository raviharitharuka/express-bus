# Copy to backend/.env (not committed). Real environment variables override these.

# Which dataset the backend loads at startup:
#   synthetic  demo data: data/timetable.json, stations.json, drivers.json, buses.json, routes.json
#   gtfs       real VAG city bus trips from the VGN GTFS feed (data/*_gtfs*.json, scripts/build_real_timetable.py).
#              Only trips, routes and stop names are real; duties, drivers and buses are synthetic.
DATA_SOURCE=synthetic

# Optional demo clock. gtfs data covers 2026-07-01; synthetic data covers 2026-10-01 to 2026-10-30.
# DEMO_DATE=2026-10-05
# DEMO_TIME=09:15

# Time budget in seconds for all CP-SAT solves of one /optimize request (default 8). If it runs out,
# the last good result for the same request is returned with "cached": true.
# OPTIMIZE_TIME_LIMIT_S=8

# Optional: lets Lotse use Claude to classify questions and phrase answers. Leave empty to use the
# keyword rules only. Never commit a real key (backend/.env is git-ignored).
ANTHROPIC_API_KEY=
